# Add keys for the models you're testing
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Structured generation benchmark (Nebius Token Factory)
NEBIUS_API_KEY=

# Required: comma-separated model IDs available to your Nebius account
GENERATION_MODELS=

# Optional: runs per model (default: 10)
# GENERATION_RUNS=10

# DRY_RUN=true uses one model/run and makes real API calls.
# New results go to results/generation/runs/<unique-directory>/.
